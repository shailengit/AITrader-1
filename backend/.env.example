# TradeCraft Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# PostgreSQL Database (REQUIRED - no defaults)
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5431
DB_NAME=sp1500_1d

# JWT Authentication (REQUIRED - generate with: openssl rand -hex 32)
JWT_SECRET_KEY=

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# LLM / Ollama
OLLAMA_MODEL=glm-5:cloud
OLLAMA_MODEL_FALLBACK=minimax-m2.5:cloud
LOCAL_LLM_API_BASE=http://localhost:11434/v1
LOCAL_LLM_API_KEY=not-needed

# External APIs
FINNHUB_API_KEY=

# Optional: Redis caching
# REDIS_URL=redis://localhost:6379/0
