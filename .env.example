# TradeCraft Environment Configuration
# Copy this file to .env and fill in your actual values

# PostgreSQL Database
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=127.0.0.1
DB_PORT=5431
DB_NAME=sp1500_1d

# JWT Authentication (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change_this_to_a_random_32_byte_hex_string

# CORS Origins (comma-separated, no spaces)
# For development:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
# For production:
# CORS_ORIGINS=https://yourdomain.com

# LLM Configuration
OLLAMA_MODEL=glm-5:cloud
OLLAMA_MODEL_FALLBACK=minimax-m2.5:cloud
LOCAL_LLM_API_BASE=http://localhost:11434/v1
LOCAL_LLM_API_KEY=not-needed

# Finnhub API Key (for earnings calendar sync)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Redis (optional, for caching)
# REDIS_URL=redis://localhost:6379/0
